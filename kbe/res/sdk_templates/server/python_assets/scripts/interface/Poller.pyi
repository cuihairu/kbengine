from __future__ import annotations

from typing import Any


class Poller:
    def __init__(self) -> None: ...
    def start(self, addr: str, port: int) -> None: ...
    def stop(self) -> None: ...
    def onWrite(self, fileno: int) -> None: ...
    def onRecv(self, fileno: int) -> None: ...
    def processData(self, sock: Any, datas: bytes) -> None: ...
