from collections.abc import Callable, Sequence
from typing import Any, BinaryIO, Dict, IO, List, TextIO, Tuple, Union, overload

from _KBEngine_common import Vector3Like, WatcherValue

# Type aliases
EntityEventCallback = Callable[..., Any]
BotCallback = Callable[[], Any]
HttpCallback = Callable[[int, str, str, bool, str], Any]

LOG_TYPE_NORMAL: int
LOG_TYPE_INFO: int
LOG_TYPE_ERR: int
LOG_TYPE_DBG: int
LOG_TYPE_WAR: int

component: str

class Entity:
    id: int
    className: str
    spaceID: int
    position: Vector3Like
    direction: Vector3Like
    # ---- client_lib/entity.cpp:43-46 getset ----
    velocity: float
    clientapp: Any

    def __init__(self) -> None: ...
    def __getattr__(self, name: str) -> Any: ...
    # 注：baseCall/cellCall/isOnGround/inWorld 不存在——远端调用走
    # entity.base/cell 的 EntityCall 路径（lib/client_lib/entity.cpp:41-42）；
    # isOnGround/inWorld 仅为 C++ 访问器（client_lib/entity.h:172/:167），未暴露给脚本。
    # ---- lib/client_lib/entity.cpp:29-33 ----
    def moveToPoint(
        self,
        destination: Vector3Like,
        velocity: float,
        distance: float,
        userData: Any,
        faceMovement: int,
        moveVertically: int,
    ) -> int: ...
    def cancelController(self, controllerID: Union[int, str]) -> None: ...
    def addTimer(
        self, initialOffset: float, repeatOffset: float, userArg: int
    ) -> int: ...
    def delTimer(self, id: Union[int, str]) -> None: ...
    def isPlayer(self) -> bool: ...
    def getComponent(self, componentName: str, all: bool = False) -> Any: ...
    def fireEvent(self, eventName: str, *args: Any) -> None: ...
    def registerEvent(
        self, eventName: str, callback: EntityEventCallback
    ) -> None: ...
    def deregisterEvent(
        self, eventName: str, callback: EntityEventCallback
    ) -> None: ...

class EntityComponent:
    def __init__(self) -> None: ...
    def __getattr__(self, name: str) -> Any: ...
    def fireEvent(self, eventName: str, *args: Any) -> None: ...
    def registerEvent(
        self, eventName: str, callback: EntityEventCallback
    ) -> None: ...
    def deregisterEvent(
        self, eventName: str, callback: EntityEventCallback
    ) -> None: ...

class Entities(Dict[int, Entity]):
    pass

class ClientObject:
    id: int
    entities: Entities

    def player(self) -> Union[Entity, None]: ...
    def getSpaceData(self, key: str) -> str: ...
    def callback(
        self, initialOffset: float, callbackObj: BotCallback
    ) -> int: ...
    def cancelCallback(self, id: int) -> None: ...
    def getWatcher(self, path: str) -> WatcherValue: ...
    def getWatcherDir(self, path: str) -> Tuple[str, ...]: ...
    def disconnect(self, lock_secs: int = 0) -> None: ...
    def kbassert(self) -> None: ...

class PyBots(Dict[int, ClientObject]):
    def has_key(self, clientID: int) -> bool: ...
    def keys(self) -> List[int]: ...
    def values(self) -> List[ClientObject]: ...
    def items(self) -> List[Tuple[int, ClientObject]]: ...
    @overload
    def get(self, clientID: int) -> Union[ClientObject, None]: ...
    @overload
    def get(self, clientID: int, default: Any) -> Union[ClientObject, Any]: ...

bots: PyBots

def addBots(
    reqCreateAndLoginTotalCount: int,
    reqCreateAndLoginTickCount: int = 0,
    reqCreateAndLoginTickTime: float = 0.0,
) -> None: ...
def scriptLogType(logType: int) -> None: ...
def genUUID64() -> int: ...
# ---- ClientApp 公共面注入 bots 的 KBEngine 模块
#      （lib/client_lib/clientapp.cpp:191-215）----
def publish() -> int: ...
def hasRes(res: str) -> bool: ...
def open(
    res: str, mode: str = "r"
) -> Union[IO[Any], TextIO, BinaryIO]: ...
def listPathRes(
    path: str, extension: Union[str, Sequence[str]] = ""
) -> Tuple[str, ...]: ...
def matchPath(res: str) -> str: ...
def getWatcher(path: str) -> WatcherValue: ...
def getWatcherDir(path: str) -> Tuple[str, ...]: ...
def urlopen(
    url: str,
    callback: Union[HttpCallback, None] = None,
    postData: Union[bytes, None] = None,
    headers: Union[Dict[str, str], None] = None,
) -> None: ...
def __getattr__(name: str) -> Any: ...
