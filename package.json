{
  "name": "kbengine-docs",
  "version": "1.0.0",
  "description": "KBEngine Documentation",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:verify": "bash -lc \"source tools/setup_doc_verifier.sh && ./.venv-docs/bin/python tools/verify_authoritative_docs.py\"",
    "test:docs": "python3 -m unittest discover -s tools/tests -v"
  },
  "devDependencies": {
    "@binyamin/markdown-it-wikilinks": "^2.0.0",
    "@braintree/sanitize-url": "^7.1.2",
    "cytoscape": "^3.34.4",
    "cytoscape-cose-bilkent": "^4.1.0",
    "dayjs": "^1.11.23",
    "mermaid": "^10.9.8",
    "sass-embedded": "^1.107.1",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  },
  "keywords": [
    "kbengine",
    "documentation",
    "vitepress"
  ],
  "author": "KBEngine Team",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0"
}
