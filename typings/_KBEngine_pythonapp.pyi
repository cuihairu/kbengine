from collections.abc import Callable, Sequence
from typing import Any, BinaryIO, Dict, IO, List, TextIO, Tuple, Union, overload

# Type aliases
TimerCallback = Callable[[int], Any]
FileDescriptorCallback = Callable[[int], Any]
HttpCallback = Callable[[int, str, str, bool, str], Any]

class MemoryStream:
    def __init__(self) -> None: ...
    def append(self, dataType: str, value: Any) -> None: ...
    def pop(self, dataType: str) -> Any: ...
    # 方法名即 bytes（非 __bytes__ dunder），lib/pyscript/py_memorystream.cpp:30
    def bytes(self) -> bytes: ...
    # 读/写位置：0 参取值 -> int，1 参设位置 -> None（py_memorystream.cpp:540/576）
    @overload
    def rpos(self) -> int: ...
    @overload
    def rpos(self, pos: int) -> None: ...
    @overload
    def wpos(self) -> int: ...
    @overload
    def wpos(self, pos: int) -> None: ...
    # val 须为 bytes 或 MemoryStream（py_memorystream.cpp:604-646）
    def fill(self, val: Union[bytes, "MemoryStream"]) -> None: ...
    def __reduce_ex__(self, protocol: int) -> Any: ...

LOG_TYPE_NORMAL: int
LOG_TYPE_INFO: int
LOG_TYPE_ERR: int
LOG_TYPE_DBG: int
LOG_TYPE_WAR: int
NEXT_ONLY: int

component: str

def publish() -> int: ...
def scriptLogType(logType: int) -> None: ...
def getResFullPath(res: str) -> str: ...
def hasRes(res: str) -> bool: ...
def open(res: str, mode: str = "r") -> Union[IO[Any], TextIO, BinaryIO]: ...
def listPathRes(
    path: str, extension: Union[str, Sequence[str]] = ""
) -> Tuple[str, ...]: ...
def matchPath(res: str) -> str: ...
def debugTracing() -> None: ...
def genUUID64() -> int: ...
def addTimer(
    initialOffset: float, repeatOffset: float, callbackObj: TimerCallback
) -> int: ...
def delTimer(id: int) -> int: ...
def registerReadFileDescriptor(
