  },
  "devDependencies": {
    "@braintree/sanitize-url": "^7.1.2",
    "cytoscape": "^3.33.2",
    "cytoscape-cose-bilkent": "^4.1.0",
    "dayjs": "^1.11.20",
    "mermaid": "^10.9.0",
    "sass-embedded": "^1.98.0",
    "vitepress": "^1.6.0",
    "vitepress-plugin-mermaid": "^2.0.16"
  },
  "keywords": [
    "kbengine",
    "documentation",
    "vitepress"
  ],
  "author": "KBEngine Team",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0"
